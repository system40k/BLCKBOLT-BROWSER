{
  "name": "blckbolt-browser",
  "version": "1.1.0",
  "description": "BLCKBOLT-BROWSER: Enterprise Privacy Browser (Electron)",
  "main": "main/bootstrap.js",
  "scripts": {
    "dev": "next dev renderer",
    "build:renderer": "next build renderer",
    "start": "electron .",
    "build": "npm run build:renderer && electron-builder",
    "build:prod": "npm run build:renderer && electron-builder -p never",
    "build:win": "npm run build:renderer && electron-builder --win nsis portable -p never",
    "build:linux": "npm run build:renderer && electron-builder --linux appimage deb -p never",
    "build:mac": "npm run build:renderer && electron-builder --mac dmg zip -p never",
    "build:all": "npm run build:renderer && electron-builder -mwl -p never",
    "lint": "eslint main renderer",
    "typecheck": "cd renderer && tsc --noEmit",
    "security:audit": "npm audit --audit-level=high",
    "verify": "npm run lint && npm run typecheck && npm run security:audit"
  },
  "author": {"name":"hybeprojects","email":"contact@hybe.pro"},
  "license": "MIT",
  "dependencies": {
    "electron-updater": "^6.8.9",
    "framer-motion": "^11.2.2",
    "next": "14.2.35",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "socks-proxy-agent": "^8.0.3",
    "tailwindcss": "^3.4.10"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "^14.2.35",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.2",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "autoprefixer": "^10.4.19",
    "electron": "43.2.0",
    "electron-builder": "26.15.3",
    "eslint": "^8.56.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^4.6.2",
    "postcss": "^8.4.39",
    "typescript": "^5.5.4"
  },
  "build": {
    "appId": "com.blckbolt.browser",
    "productName": "BLCKBOLT Browser",
    "directories": {"output":"dist","buildResources":"main/assets"},
    "files": ["main/**/*","renderer/out/**/*","package.json","!dist","!**/*.map"],
    "extraMetadata": {"main":"main/bootstrap.js"},
    "publish": [{"provider":"github","owner":"system40k","repo":"BLCKBOLT-BROWSER"}],
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "BLCKBOLT Browser",
      "installerIcon": "main/assets/icon.ico",
      "uninstallerIcon": "main/assets/icon.ico",
      "installerHeaderIcon": "main/assets/icon.ico",
      "displayLanguageSelector": false,
      "license": "LICENSE.txt",
      "artifactName": "BLCKBOLT-Browser-Setup-${version}.exe"
    },
    "win": {
      "target":[{"target":"nsis","arch":["x64"]},{"target":"portable","arch":["x64"]},{"target":"zip","arch":["x64"]}],
      "icon":"main/assets/icon.ico",
      "signingHashAlgorithms":["sha256"]
    },
    "linux": {
      "target":[{"target":"AppImage","arch":["x64","arm64"]},{"target":"deb","arch":["x64","arm64"]}],
      "category":"Development",
      "maintainer":"hybeprojects <contact@hybe.pro>",
      "icon":"main/assets/icon.png",
      "artifactName":"BLCKBOLT-Browser-${version}-${arch}.${ext}"
    },
    "deb":{"artifactName":"BLCKBOLT-Browser-${version}-${arch}.deb","depends":["libappindicator1","libnotify-bin"]},
    "protocols":[{"name":"BLCKBOLT Protocol","schemes":["blckbolt"],"role":"Viewer"}],
    "mac":{"category":"public.app-category.developer-tools","icon":"main/assets/icon.icns","target":["dmg","zip"],"hardenedRuntime":true,"gatekeeperAssess":false}
  }
}
